{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RasterSVG",
  "version": "0.1.1",
  "identifier": "io.github.rastersvg",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RasterSVG",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Raster to SVG converter",
    "longDescription": "RasterSVG converts raster images into layered SVG files.",
    "license": "GPL-2.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "targets": "all"
  }
}
